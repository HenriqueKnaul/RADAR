<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:orientation="vertical">
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.Title" />
    <TextView android:id="@+id/teacher" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.Subtitle" />
    <Button android:id="@+id/edit" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Material3.Button.OutlinedButton" android:text="@string/ui_editar_disciplina" />
    <Button android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Material3.Button.OutlinedButton" android:text="@string/ui_excluir_disciplina" />
    <Button android:id="@+id/add" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_nova_tarefa_nesta_disciplina" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.Section" android:text="@string/ui_atividades_vinculadas" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.Empty" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/taskList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
