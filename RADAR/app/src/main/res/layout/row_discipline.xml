<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
    <View android:id="@+id/color" android:layout_width="32dp" android:layout_height="4dp" android:layout_marginBottom="8dp" />
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.RowTitle" />
    <TextView android:id="@+id/teacher" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Radar.Body" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
